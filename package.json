{
  "name": "lab-5-fs",
  "version": "1.0.0",
  "description": "Lab 5 - File system data storage and stream handling",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#models/book.model": "./models/book.model.js",
    "#controllers/book.controller": "./controllers/book.controller.js",
    "#routes/book.routes.v1": "./routes/book.routes.v1.js",
    "#routes/book.routes.v2": "./routes/book.routes.v2.js",
    "#repositories/book.repository": "./repositories/book.repository.js",
    "#schemas/env.schema": "./schemas/env.schema.js",
    "#schemas/book.schema": "./schemas/book.schema.js",
    "#constants/messages": "./constants/messages.js",
    "#utils/fs.utils": "./utils/fs.utils.js",
    "#utils/url.utils": "./utils/url.utils.js",
    "#migrations/migrate": "./migrations/migrate.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "predev": "npm run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "seed": "node scripts/seed.js",
    "migrate": "node migrations/migrate.js",
    "external": "json-server db.json --port 3001"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/env": "^5.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^8.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.15.0",
    "json-server": "^1.0.0-beta.15",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2"
  }
}
