{
  "name": "lab-3-common",
  "version": "1.0.0",
  "description": "Lab 3 - CommonJS framework technologies project",
  "main": "app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#data/books.data": "./data/books.data.js",
    "#utils/logger": "./utils/logger.js",
    "#controllers/book.controller": "./controllers/book.controller.js",
    "#routes/book.routes": "./routes/book.routes.js",
