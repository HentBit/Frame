{
  "name": "lab-4-fastify",
  "version": "1.0.0",
  "description": "Lab 4 - Fastify framework project",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#data/books.data": "./data/books.data.js",
    "#controllers/book.controller": "./controllers/book.controller.js",
    "#routes/book.routes": "./routes/book.routes.js",
    "#repositories/book.repository": "./repositories/book.repository.js",
    "#schemas/env.schema": "./schemas/env.schema.js",
    "#schemas/book.schema": "./schemas/book.schema.js",
    "#constants/messages": "./constants/messages.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "predev": "npm run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/env": "^5.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.15.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2"
  }
}
